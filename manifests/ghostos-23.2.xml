<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Verified Android 16 / LineageOS 23.2 foundation for the first bring-up. -->
  <remote name="lineage" fetch="https://github.com/LineageOS" revision="lineage-23.2" />
  <remote name="themuppets" fetch="https://github.com/TheMuppets" revision="lineage-23.2" />

  <!-- OnePlus Nord CE 3 Lite 5G (larry) and its declared OPlus hardware dependency. -->
  <project name="android_device_oneplus_larry" path="device/oneplus/larry" remote="lineage" revision="lineage-23.2" />
  <project name="android_device_oneplus_sm6375-common" path="device/oneplus/sm6375-common" remote="lineage" revision="lineage-23.2" />
  <project name="android_hardware_oplus" path="hardware/oplus" remote="lineage" revision="lineage-23.2" />
  <project name="android_kernel_oneplus_sm6375" path="kernel/oneplus/sm6375" remote="lineage" revision="lineage-23.2" />

  <!-- Matching proprietary vendor trees required by the larry/common device makefiles. -->
  <project name="proprietary_vendor_oneplus_larry" path="vendor/oneplus/larry" remote="themuppets" revision="lineage-23.2" />
  <project name="proprietary_vendor_oneplus_sm6375-common" path="vendor/oneplus/sm6375-common" remote="themuppets" revision="lineage-23.2" />

  <!-- OnePlus Nord CE 2 Lite 5G (oscaro): same verified SM6375 kernel/common foundation. -->
  <project name="android_device_oneplus_oscaro" path="device/oneplus/oscaro" remote="lineage" revision="lineage-23.2" />
</manifest>
